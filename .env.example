# MockMate Environment Variables

# Supabase (PostgreSQL & Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LLM Configuration (Default: Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
# Optional model override (defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Judge0 Code Execution API
# Free Judge0 CE on RapidAPI or self-hosted Judge0 instance
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_or_judge0_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Razorpay Payments (INR)
# Get keys from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate Limiting & Demo Fallbacks
ENABLE_DEMO_MODE=true
MAX_MESSAGES_PER_INTERVIEW=16
MAX_TOKENS_PER_CALL=1024
